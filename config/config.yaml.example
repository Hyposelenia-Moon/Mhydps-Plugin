# Mhydps-Plugin 配置文件
# 优先级：数字越小越先执行。默认 8000 —— 低于 Atlas-Plugin 的 10000，
# 保证 #DPS… 系列命令先由本插件接管，未命中时自然放行给其它插件
priority: 8000

# 渲染缩放比例（0.5 ~ 3，越大越清晰但渲染越慢）
renderScale: 1.5

# ---------- 网络 ----------
# 抓取 mhydps.cn 使用的代理，留空 = 直连
# 实测国内网络直连 www.mhydps.cn 会被重置（TLS 握手阶段 RST），需要本地代理才能拉取
# 例：http://127.0.0.1:7890
proxy: ''

# 单次请求超时（毫秒，3000 ~ 120000）
timeoutMs: 30000

# ---------- 缓存 ----------
# 榜单数据缓存有效期（分钟）：超过后下一次查询会自动重新拉取
cacheTtlMinutes: 30

# 榜单每页条数（1 ~ 20）
pageSize: 10

# 是否缓存并渲染角色立绘（关闭后成图里以角色名文字占位）
avatarEnabled: true
