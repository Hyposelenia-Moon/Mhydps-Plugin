# Mhydps-Plugin 配置文件
# 优先级：数字越小越先执行。默认 8000 —— 低于 Atlas-Plugin 的 10000，
# 保证 #DPS… 系列命令先由本插件接管，未命中时自然放行给其它插件
priority: 8000

# 渲染缩放比例（0.5 ~ 3，越大越清晰但渲染越慢）
renderScale: 1.5

# ---------- 网络 ----------
# 抓取 mhydps.cn 使用的代理，留空 = 直连
# 实测国内网络直连 www.mhydps.cn 会被重置（TLS 握手阶段 RST），需要本地代理才能拉取
# 例：http://<代理主机>:<端口>
proxy: ''

# 单次请求超时（毫秒，3000 ~ 120000）
timeoutMs: 30000

# ---------- 缓存 ----------
# 榜单数据缓存有效期（分钟）：超过后下一次查询会自动重新拉取
cacheTtlMinutes: 30

# 榜单每页条数（1 ~ 20）
pageSize: 10

# 是否缓存并渲染角色立绘（关闭后成图里以角色名文字占位）
avatarEnabled: true

# ---------- 练度查询 ----------
# 默认 UID：命令里不写 UID 时用它（例：直接发「#DPS练度查询 胡桃」）
defaultUid: ''

# 面板立绘图库根目录（含 normal-character 的那一层目录），留空 = 自动探测
# 自动探测顺序：
#   plugins/ProfileImg-Plugin/resources/gallery/ProfileImg/miao-plugin-ProfileImg
#   plugins/miao-plugin/resources/profile
# 图库（AxiuCN/miao-plugin-ProfileImg，300MB+）需自行安装，本插件只读引用、不随包分发
profileImgDir: ''

# miao-plugin 的 resources 目录（面板图标：命座 / 武器 / 圣遗物），留空 = 自动探测
# 自动探测 plugins/miao-plugin/resources；未安装时面板照常出图，只是不显示图标
miaoResDir: ''
