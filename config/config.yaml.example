# Mhydps-Plugin 配置文件
# 优先级：数字越小越先执行。默认 8000 —— 低于 Atlas-Plugin 的 10000，
# 保证 #DPS… 系列命令先由本插件接管，未命中时自然放行给其它插件
priority: 8000

# 渲染缩放比例（0.5 ~ 3，越大越清晰但渲染越慢）
renderScale: 1.5

# ---------- 数据源一 · mhydps.cn（DPS榜 / 危战榜） ----------
# 抓取 mhydps.cn 使用的代理，留空 = 直连
# 实测国内网络直连 www.mhydps.cn 会被重置（TLS 握手阶段 RST），需要本地代理才能拉取
# 例：http://<代理主机>:<端口>
proxy: ''

# 单次请求超时（毫秒，3000 ~ 120000）
timeoutMs: 30000

# ---------- 数据源一 · 缓存 ----------
# 榜单数据缓存有效期（分钟）：超过后下一次查询会自动重新拉取
cacheTtlMinutes: 30

# 榜单每页条数（1 ~ 20）
pageSize: 10

# 是否缓存并渲染角色立绘（关闭后成图里以角色名文字占位）
avatarEnabled: true

# ---------- 数据源二 · akasha.cv（练度查询） ----------
# 默认 UID：命令里不写 UID 时用它（例：直接发「#DPS练度查询 胡桃」）
defaultUid: ''

# ---------- 数据源二 · akasha.cv（练度查询） ----------
# 启用练度查询：练度数据来自 akasha.cv（mhydps.cn 只有匿名配队榜，没有练度排名）
# 实测 akasha 的 /api/ 在 Cloudflare 后面，纯 HTTP 取数会被挡（403 挑战页），
# 取数机制（浏览器会话）还在确认中；关闭本项后该命令只提示未启用，不发任何请求
akashaEnabled: true

# akasha 的代理，留空 = 直连（akasha 不在墙内，通常直连即可）
akashaProxy: ''

# akasha 单次请求超时（毫秒，5000 ~ 180000）
akashaTimeoutMs: 60000

# akasha 练度数据缓存有效期（分钟，最小 1）
akashaCacheTtlMinutes: 30

# 一次练度查询最多列几个角色（1 ~ 30）
akashaMaxChars: 12

